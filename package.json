{
  "name": "sovereignty-trade-off-navigator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node -e 'const fs=require(\"fs\"); if(fs.existsSync(\".app_api_tmp\") && !fs.existsSync(\"app/api\")) { console.log(\"Auto-restoring app/api from .app_api_tmp...\"); fs.renameSync(\".app_api_tmp\", \"app/api\"); }'",
    "dev": "next dev",
    "build": "next build",
    "build:static": "./scripts/build-static.sh",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx scripts/sync-import.ts",
    "db:import": "tsx scripts/sync-import.ts",
    "mcp:start": "tsx scripts/mcp-server.ts",
    "test": "prisma generate && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.4",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
